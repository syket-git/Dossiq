AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET=your-s3-bucket-name

OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
EMBED_DIMENSION=1024

PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=dossiq-enterprise-ai-index
PINECONE_INDEX_HOST=your-index-name-xxxxxxx.svc.us-east-1-aws.pinecone.io
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_READY_TIMEOUT=60


DATABASE_URL=postgresql://user:password@localhost:5432/rag_db

RIUS_API_KEY=your-rius-api-key
RIUS_SERVICE_NAME=dossiq-backend
RIUS_DISABLED=false
RIUS_CAPTURE_CONTENT=false

# Frontend origins allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000
